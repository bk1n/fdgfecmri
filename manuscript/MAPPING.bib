@article{achouriComplicationsLymphadenectomyGynecologic2013,
  title = {Complications of Lymphadenectomy for Gynecologic Cancer},
  author = {Achouri, A. and Huchon, C. and Bats, A. S. and Bensaid, C. and Nos, C. and L{\'e}curu, F.},
  year = {2013},
  month = jan,
  journal = {European Journal of Surgical Oncology (EJSO)},
  volume = {39},
  number = {1},
  pages = {81--86},
  issn = {0748-7983},
  doi = {10.1016/j.ejso.2012.10.011},
  abstract = {Introduction Symptomatic postoperative lymphocysts (SPOLs) and lower-limb lymphedema (LLL) are probably underestimated complications of lymphadenectomy for gynecologic malignancies. Here, our objective was to evaluate the incidence and risk factors of SPOLs and LLL after pelvic and/or aortocaval lymphadenectomy for gynecologic malignancies. Methods Single-center retrospective study of consecutive patients who underwent pelvic and/or aortocaval lymphadenectomy for ovarian cancer, endometrial cancer, or cervical cancer between January 2007 and November 2008. The incidences of SPOL and LLL were computed with their 95\% confidence intervals (95\%CIs). Multivariate logistic regression was performed to identify independent risk factors for SPOL and LLL. Results We identified 88 patients including 36 with ovarian cancer, 35 with endometrial cancer, and 17 with cervical cancer. The overall incidence of SPOL was 34.5\% (95\%CI, 25\textendash 45) and that of LLL was 11.4\% (95\% confidence interval [95\%CI], 5\textendash 18). Endometrial cancer was independently associated with a lower risk of SPOL (adjusted odds ratio [aOR], 0.09; 95\%CI, 0.02\textendash 0.44) and one or more positive pelvic nodes with a higher risk of SPOL (aOR, 4.4; 95\%CI, 1.2\textendash 16.3). Multivariate logistic regression failed to identify factors significantly associated with LLL. Conclusion Complications of lymphadenectomy for gynecologic malignancies are common. This finding supports a more restrictive use of lymphadenectomy or the use of less invasive techniques such as sentinel node biopsy.},
  langid = {english},
  keywords = {Lymphadenectomy,Lymphedema,Lymphocyst,Ovarian cancer,Uterine cancer},
  annotation = {147 citations (Crossref) [2022-12-09]}
}

@article{antonsenSUVmax18FDGPET2013,
  title = {{{SUVmax}} of {{18FDG PET}}/{{CT}} as a Predictor of High-Risk Endometrial Cancer Patients},
  author = {Antonsen, Sofie Leisby and Loft, Annika and Fisker, Rune and Nielsen, Anne Lerberg and Andersen, Erik S{\o}gaard and H{\o}gdall, Estrid and Tabor, Ann and Jochumsen, Kirsten and {Fag{\"o}-Olsen}, Carsten L. and Asmussen, Jon and Berthelsen, Anne Kiil and Christensen, Ib Jarle and H{\o}gdall, Claus},
  year = {2013},
  month = may,
  journal = {Gynecologic Oncology},
  volume = {129},
  number = {2},
  pages = {298--303},
  issn = {0090-8258},
  doi = {10.1016/j.ygyno.2013.01.019},
  abstract = {Objective To evaluate SUVmax in the assessment of endometrial cancer preoperatively with particular focus on myometrial invasion (MI), cervical invasion (CI), FIGO stage, risk-stratification and lymph node metastases (LNM). Methods A total of 268 women with endometrial cancer or atypical endometrial hyperplasia underwent FDG PET/CT imaging before surgical treatment. SUVmax of the primary tumour was compared with histological prognostic factors. Results SUVmax was significantly higher in patients with high FIGO stages (p{$<$}0.0001), deep MI (p=0.002), CI (p=0.04), LNM (p=0.04) and high risk tumours (p=0.003). Linear regression found that SUVmax was dependent of MI (p=0.001, 95\% CI 2.863\textendash 11.098), CI (p=0.001, 95\% CI 2.896\textendash 11.499), risk (p=0.004, 95\% CI 0.077\textendash 0.397), LNM (p=0.04, 95\% CI 0.011\textendash 0.482) and FIGO stage (p{$<$}0.0001, 95\% CI 0.158\textendash 0.473). Conclusions Preoperative PET/CT scanning and SUVmax measurements of the primary tumour may provide additional clinical and prognostic information about MI, CI, LNM and high risk disease in patients with endometrial cancer and allow for individualization of patient care. However, the sensitivity and specificity of the SUVmax in staging endometrial cancer is not high enough to reliably replace surgical staging.},
  langid = {english},
  keywords = {Endometrial cancer,Maximum standardized uptake value (SUVmax),PET/CT,Preoperative staging,Risk-stratification},
  annotation = {40 citations (Crossref) [2022-12-09]}
}

@article{beddyEvaluationDepthMyometrial2012,
  title = {Evaluation of {{Depth}} of {{Myometrial Invasion}} and {{Overall Staging}} in {{Endometrial Cancer}}: {{Comparison}} of {{Diffusion-weighted}} and {{Dynamic Contrast-enhanced MR Imaging}}},
  shorttitle = {Evaluation of {{Depth}} of {{Myometrial Invasion}} and {{Overall Staging}} in {{Endometrial Cancer}}},
  author = {Beddy, Peter and Moyle, Penelope and Kataoka, Masako and Yamamoto, Adam K. and Joubert, Ilse and Lomas, David and Crawford, Robin and Sala, Evis},
  year = {2012},
  month = feb,
  journal = {Radiology},
  volume = {262},
  number = {2},
  pages = {530--537},
  publisher = {{Radiological Society of North America}},
  issn = {0033-8419},
  doi = {10.1148/radiol.11110984},
  abstract = {Purpose To compare the diagnostic performance of diffusion-weighted (DW) magnetic resonance (MR) imaging with that of dynamic contrast material\textendash enhanced (DCE) MR imaging in evaluating the depth of myometrial invasion and overall stage in patients with endometrial cancer. Materials and Methods The institutional review board approved this retrospective study; patient consent was not required. From May 2008 to February 2010, 48 women with endometrial cancer underwent preoperative MR imaging, including T1- and T2-weighted imaging, DW MR imaging (b = 0 and 800 sec/mm2) and DCE MR imaging. Two radiologists independently interpreted the depth of myometrial invasion, overall stage, and presence of pitfalls associated with inaccurate assessment of myometrial invasion at T1- and T2-weighted imaging, DW MR imaging, and DCE MR imaging. Myometrial invasion and overall stage were compared by using the McNemar test, and {$\kappa$} statistics were used for reader agreement. Results For assessing the depth of myometrial invasion, diagnostic accuracy, sensitivity, and specificity, respectively, were as follows: DW MR imaging\textemdash reader 1, 90\%, 84\%, and 100\%; reader 2, 85\%, 84\%, and 88\%; DCE MR imaging\textemdash reader 1, 71\%, 61\%, and 88\%; reader 2, 79\%, 77\%, and 82\%. The improvement in diagnostic accuracy for reader 1 was significant (P = .035). For myometrial invasion, {$\kappa$} values were 0.75 with DW MR imaging and 0.26 with DCE MR imaging. There was no association between inaccurate assessment of myometrial invasion and standard pitfalls with DW MR imaging. Readers 1 and 2 correctly staged more patients by using DW MR imaging (39 and 38 patients, respectively) than by using DCE MR imaging (29 and 30 patients, respectively) (P {$<$} .05). For overall stage, {$\kappa$} values were 0.74 with DW MR imaging and 0.22 with DCE MR imaging. Conclusion DW MR imaging has superior diagnostic accuracy in the assessment of myometrial invasion and significantly higher staging accuracy compared with DCE MR imaging. \textcopyright{} RSNA, 2011},
  annotation = {132 citations (Crossref) [2022-12-09]}
}

