@article{husbyMetabolicTumorVolume2015,
  title = {Metabolic {{Tumor Volume}} on {{18F-FDG PET}}/{{CT Improves Preoperative Identification}} of {{High-Risk Endometrial Carcinoma Patients}}},
  author = {Husby, Jenny A. and Reitan, Bernt C. and Biermann, Martin and Trovik, Jone and Bj{\o}rge, Line and Magnussen, Inger J. and Salvesen, {\O}yvind O. and Salvesen, Helga B. and Haldorsen, Ingfrid S.},
  year = {2015},
  month = aug,
  journal = {Journal of Nuclear Medicine},
  volume = {56},
  number = {8},
  pages = {1191--1198},
  publisher = {{Society of Nuclear Medicine}},
  issn = {0161-5505, 2159-662X},
  doi = {10.2967/jnumed.115.159913},
  abstract = {Our objective was to prospectively explore the diagnostic value of 18F-FDG PET/CT for preoperative staging in endometrial carcinomas and to investigate whether 18F-FDG PET\textendash specific quantitative tumor parameters reflect clinical and histologic characteristics. Methods: Preoperative 18F-FDG PET/CT was prospectively performed on 129 consecutive endometrial carcinoma patients. Two physicians who did not know the clinical findings or staging results independently reviewed the images, assessing primary tumor, cervical stroma involvement and metastatic spread, and determining maximum and mean standardized uptake value (SUVmax and SUVmean, respectively) for tumor, metabolic tumor volume (MTV), and total lesion glycolysis (TLG). All parameters were analyzed in relation to histomorphologic and clinical tumor characteristics. Receiver-operating-characteristic curves for identification of deep myometrial invasion and lymph node metastases were generated, and MTV cutoffs for predicting deep myometrial invasion and lymph node metastases were calculated. Results: The sensitivity, specificity, and accuracy of 18F-FDG PET/CT for the detection of lymph node metastases were 77\%\textendash 85\%, 91\%\textendash 96\%, and 89\%\textendash 93\%, respectively. SUVmax, SUVmean, MTV, and TLG were significantly related to deep myometrial invasion, presence of lymph node metastases, and high histologic grade (P {$<$} 0.015 for all) and independently predicted deep myometrial invasion (P {$<$} 0.015) and lymph node metastases (P {$<$} 0.025) after adjustment for preoperative histologic risk (based on subtype and grade) in endometrial biopsies. Optimal cutoffs for MTV in predicting deep myometrial invasion (20 mL) and the presence of lymph node metastases (30 mL) yielded odds ratios of 7.8 (P {$<$} 0.001) and 16.5 (P = 0.001), respectively. Conclusion: 18F-FDG PET/CT represents a clinically valuable tool for preoperatively evaluating the presence of lymph node metastases in endometrial carcinoma patients. Applying MTV cutoffs for the prediction of deep myometrial invasion and lymph node metastases may increase diagnostic accuracy and aid preoperative identification of high-risk patients, enabling restriction of lymphadenectomy for patients with a low risk of aggressive disease.},
  chapter = {Clinical Investigations},
  copyright = {\textcopyright{} 2015 by the Society of Nuclear Medicine and Molecular Imaging, Inc.},
  langid = {english},
  pmid = {26045311},
  keywords = {18F-FDG PET/CT,cancer staging,endometrial carcinoma,incidental findings,metabolic tumor volume},
  annotation = {69 citations (Crossref) [2022-12-09]},
  file = {/Users/benjamin.king/Zotero/storage/EPG9J9ZA/Husby et al. - 2015 - Metabolic Tumor Volume on 18F-FDG PETCT Improves .pdf}
}

