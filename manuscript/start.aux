\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Quantitative measures of lymph nodes of each region on FDG-PET/CT (left), FEC-PET/CT (middle), and DW-MRI (right). Nodes from endometrial and cervical cancer were pooled together for this comparison.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:quant_byRegion}{{1}{9}{Quantitative measures of lymph nodes of each region on FDG-PET/CT (left), FEC-PET/CT (middle), and DW-MRI (right). Nodes from endometrial and cervical cancer were pooled together for this comparison}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Quantitative measures of lymph nodes in cervical and endometrial cancer on DG-PET/CT (left), FEC-PET/CT (middle), and DW-MRI (right). All regions are pooled together for this comparison.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:quant_byCancer}{{2}{9}{Quantitative measures of lymph nodes in cervical and endometrial cancer on DG-PET/CT (left), FEC-PET/CT (middle), and DW-MRI (right). All regions are pooled together for this comparison}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  (A) Quantitive and calculated measures on FDG-PET/CT were significantly higher in malignant (M) than benign (B) lymph nodes in endometrial cancer. (B) SUVmax, short-axis diameter (SA), and SUVmax-to-ADCmean ratio (STAR) on FEC-PET/CT were significantly higher in malignant than benign lymph nodes in endometrial cancer. (C) No significant difference was observed between quantitive measures from DW-MRI in endometrial cancer. Nodes of all regions are pooled together for this analysis. Significance was tested between groups using Mann-Whitney U-test. ***, p $<$ 0.001, **, p $<$ 0.01, *, p $<$ 0.05. B, benign; M, malignant; SA, short-axis diameter, LA, long-axis diameter; NTR, nodal-to-tumour ratio (SUVmax for FDG-PET/CT and FEC-PET/CT, and ADCmean for DW-MRI); STAR, SUVmax-to-ADCmean ratio; STSA, SUVmax-to-SA diameter ratio. }}{10}{figure.3}\protected@file@percent }
\newlabel{fig:quant_inEndo}{{3}{10}{(A) Quantitive and calculated measures on FDG-PET/CT were significantly higher in malignant (M) than benign (B) lymph nodes in endometrial cancer. (B) SUVmax, short-axis diameter (SA), and SUVmax-to-ADCmean ratio (STAR) on FEC-PET/CT were significantly higher in malignant than benign lymph nodes in endometrial cancer. (C) No significant difference was observed between quantitive measures from DW-MRI in endometrial cancer. Nodes of all regions are pooled together for this analysis. Significance was tested between groups using Mann-Whitney U-test. ***, p $<$ 0.001, **, p $<$ 0.01, *, p $<$ 0.05. B, benign; M, malignant; SA, short-axis diameter, LA, long-axis diameter; NTR, nodal-to-tumour ratio (SUVmax for FDG-PET/CT and FEC-PET/CT, and ADCmean for DW-MRI); STAR, SUVmax-to-ADCmean ratio; STSA, SUVmax-to-SA diameter ratio}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  (A) No significant difference in quantitative measures was found between malignant (M) and benign (B) lymph nodes on FDG-PET/CT in cervical cancer. (B) No significant difference in quantitative measures was found between malignant and benign lymph nodes on FEC-PET/CT in cervical cancer. (C) ADCmean and nodal-to-tumour ratio (NTR) from DW-MRI were significantly decreased in malignant compared to benign nodes. Nodes of all regions are pooled together for this analysis. Significance was tested between groups using Mann-Whitney U-test. *, p $<$ 0.05. B, benign; M, malignant; SA, short-axis diameter, LA, long-axis diameter; NTR, nodal-to-tumour ratio (SUVmax for FDG-PET/CT and FEC-PET/CT, and ADCmean for DW-MRI); STAR, SUVmax-to-ADCmean ratio; STSA, SUVmax-to-SA diameter ratio. }}{11}{figure.4}\protected@file@percent }
\newlabel{fig:quant_inCer}{{4}{11}{(A) No significant difference in quantitative measures was found between malignant (M) and benign (B) lymph nodes on FDG-PET/CT in cervical cancer. (B) No significant difference in quantitative measures was found between malignant and benign lymph nodes on FEC-PET/CT in cervical cancer. (C) ADCmean and nodal-to-tumour ratio (NTR) from DW-MRI were significantly decreased in malignant compared to benign nodes. Nodes of all regions are pooled together for this analysis. Significance was tested between groups using Mann-Whitney U-test. *, p $<$ 0.05. B, benign; M, malignant; SA, short-axis diameter, LA, long-axis diameter; NTR, nodal-to-tumour ratio (SUVmax for FDG-PET/CT and FEC-PET/CT, and ADCmean for DW-MRI); STAR, SUVmax-to-ADCmean ratio; STSA, SUVmax-to-SA diameter ratio}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  (A) SUVmax was significantly elevated in primary tumours on FDG-PET/CT in patients with malignant (M) lymph nodes compared to those with benign (B) lymph nodes in endometrial cancer. (B) No significant difference in quantitative measures of the primary tumour were found for any imaging modality in cervical cancer. **, p $<$ 0.01. }}{12}{figure.5}\protected@file@percent }
\newlabel{fig:quants_pt_byCanc}{{5}{12}{(A) SUVmax was significantly elevated in primary tumours on FDG-PET/CT in patients with malignant (M) lymph nodes compared to those with benign (B) lymph nodes in endometrial cancer. (B) No significant difference in quantitative measures of the primary tumour were found for any imaging modality in cervical cancer. **, p $<$ 0.01}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Pairwise Pearson correlation coefficients between raw quantitative measures from FDG-PET/CT, FEC-PET/CT, and DW-MRI in endometrial cancer. ***, p $<$ 0.001, **, p $<$ 0.01, *, p $<$ 0.05.}}{13}{figure.6}\protected@file@percent }
\newlabel{fig:pairwise_correlations}{{6}{13}{Pairwise Pearson correlation coefficients between raw quantitative measures from FDG-PET/CT, FEC-PET/CT, and DW-MRI in endometrial cancer. ***, p $<$ 0.001, **, p $<$ 0.01, *, p $<$ 0.05}{figure.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Diagnostic performance of quantitative measures}{14}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Performance of all raw and calculated quantitative measures from FDG-PET/CT, FEC-PET/CT, and DW-MRI as well as performance of the univariate logistic regression (LR) model trained on SUVmax from FDG-PET/CT in endometrial cancer. Red crosses on box and whisker plots represent mean performance from bootstrapped data.}}{15}{figure.7}\protected@file@percent }
\newlabel{fig:all_performance}{{7}{15}{Performance of all raw and calculated quantitative measures from FDG-PET/CT, FEC-PET/CT, and DW-MRI as well as performance of the univariate logistic regression (LR) model trained on SUVmax from FDG-PET/CT in endometrial cancer. Red crosses on box and whisker plots represent mean performance from bootstrapped data}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces ROC curves for quantitative measures from FDG-PET/CT (top left), FEC-PET/CT (top right), DW-MRI (bottom left), and the LR model (bottom right) in endometrial cancer. Line colour represents a quantitative measure for that imaging modality.}}{16}{figure.8}\protected@file@percent }
\newlabel{fig:roc_curves}{{8}{16}{ROC curves for quantitative measures from FDG-PET/CT (top left), FEC-PET/CT (top right), DW-MRI (bottom left), and the LR model (bottom right) in endometrial cancer. Line colour represents a quantitative measure for that imaging modality}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Predicted probability (blue line) of malignancy of lymph nodes from a logistic regression model trained on nodal SUVmax from FDG-PET/CT in endometrial cancer. The red dashedl line represents the optimal SUV cut-off. Points represent the SUVmax of benign (bottom) and malignant (top) lymph nodes the logistic regression model was trained on.}}{16}{figure.9}\protected@file@percent }
\newlabel{fig:lr_model_probability}{{9}{16}{Predicted probability (blue line) of malignancy of lymph nodes from a logistic regression model trained on nodal SUVmax from FDG-PET/CT in endometrial cancer. The red dashedl line represents the optimal SUV cut-off. Points represent the SUVmax of benign (bottom) and malignant (top) lymph nodes the logistic regression model was trained on}{figure.9}{}}
