\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  (A) Quantitative measures of measured lymph nodes of each region. One-way ANOVA with Tukey's post-hoc test was used to determine significance between regions. (B) Quantitative measures of measures lymph nodes in endometrial cancer and cervical cancer patients. Mann-Whitney U-test was used to determine significance between endometrial and cervical cancer. FDG-PET/CT (left), FEC-PET/CT (middle), and DW-MRI (right).}}{8}{figure.1}\protected@file@percent }
\newlabel{fig:quant_byRegion_byCancer}{{1}{8}{(A) Quantitative measures of measured lymph nodes of each region. One-way ANOVA with Tukey's post-hoc test was used to determine significance between regions. (B) Quantitative measures of measures lymph nodes in endometrial cancer and cervical cancer patients. Mann-Whitney U-test was used to determine significance between endometrial and cervical cancer. FDG-PET/CT (left), FEC-PET/CT (middle), and DW-MRI (right)}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Raw and calculated quantitative measures from benign (B) and malignant (M) lymph nodes in endometrial cancer. Nodes of all regions are pooled together for this analysis. Red lines represent optimal cutpoints for F1 score maximisation. Significance was tested between groups using Mann-Whitney U-test. ***, p $<$ 0.001, **, p $<$ 0.01, *, p $<$ 0.05. }}{9}{figure.2}\protected@file@percent }
\newlabel{fig:quant_inEndo}{{2}{9}{Raw and calculated quantitative measures from benign (B) and malignant (M) lymph nodes in endometrial cancer. Nodes of all regions are pooled together for this analysis. Red lines represent optimal cutpoints for F1 score maximisation. Significance was tested between groups using Mann-Whitney U-test. ***, p $<$ 0.001, **, p $<$ 0.01, *, p $<$ 0.05}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Raw and calculated quantitative measures from benign (B) and malignant (M) lymph nodes in cervical cancer. Nodes of all regions are pooled together for this analysis. Significance was tested between groups using Mann-Whitney U-test. *, p $<$ 0.05.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:quant_inCer}{{3}{10}{Raw and calculated quantitative measures from benign (B) and malignant (M) lymph nodes in cervical cancer. Nodes of all regions are pooled together for this analysis. Significance was tested between groups using Mann-Whitney U-test. *, p $<$ 0.05}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Pairwise Pearson correlation coefficients between raw quantitative measures from FDG-PET/CT, FEC-PET/CT, and DW-MRI in endometrial cancer. ***, p $<$ 0.001, **, p $<$ 0.01, *, p $<$ 0.05.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:pairwise_correlations}{{4}{10}{Pairwise Pearson correlation coefficients between raw quantitative measures from FDG-PET/CT, FEC-PET/CT, and DW-MRI in endometrial cancer. ***, p $<$ 0.001, **, p $<$ 0.01, *, p $<$ 0.05}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Diagnostic performance of quantitative measures}{11}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Performance of all raw and calculated quantitative measures from FDG-PET/CT, FEC-PET/CT, and DW-MRI as well as performance of the univariate logistic regression (LR) model trained on SUVmax from FDG-PET/CT in endometrial cancer. Red crosses on box and whisker plots represent mean performance from bootstrapped data.}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:all_performance}{{5}{12}{Performance of all raw and calculated quantitative measures from FDG-PET/CT, FEC-PET/CT, and DW-MRI as well as performance of the univariate logistic regression (LR) model trained on SUVmax from FDG-PET/CT in endometrial cancer. Red crosses on box and whisker plots represent mean performance from bootstrapped data}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces ROC curves for quantitative measures from FDG-PET/CT (top left), FEC-PET/CT (top right), DW-MRI (bottom left), and the LR model (bottom right) in endometrial cancer. Line colour represents a quantitative measure for that imaging modality.}}{13}{figure.6}\protected@file@percent }
\newlabel{fig:roc_curves}{{6}{13}{ROC curves for quantitative measures from FDG-PET/CT (top left), FEC-PET/CT (top right), DW-MRI (bottom left), and the LR model (bottom right) in endometrial cancer. Line colour represents a quantitative measure for that imaging modality}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Predicted probability (blue line) of malignancy of lymph nodes from a logistic regression model trained on nodal SUVmax from FDG-PET/CT in endometrial cancer. The red dashedl line represents the optimal SUV cut-off. Points represent the SUVmax of benign (bottom) and malignant (top) lymph nodes the logistic regression model was trained on.}}{13}{figure.7}\protected@file@percent }
\newlabel{fig:lr_model_probability}{{7}{13}{Predicted probability (blue line) of malignancy of lymph nodes from a logistic regression model trained on nodal SUVmax from FDG-PET/CT in endometrial cancer. The red dashedl line represents the optimal SUV cut-off. Points represent the SUVmax of benign (bottom) and malignant (top) lymph nodes the logistic regression model was trained on}{figure.7}{}}
